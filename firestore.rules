rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the authenticated user is registered in the admins collection
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Rules for the admins collection
    match /admins/{email} {
      // Allow authenticated users to read their own admin document to check credentials, or if they are already an admin
      allow read: if request.auth != null && (request.auth.token.email == email || isAdmin());
      
      // Allow initial seeding of the default admins, or updates by existing admins
      allow write: if request.auth != null && (
        email in ["sunuhacker@gmail.com", "cezanne.p.cez@gmail.com"] || 
        isAdmin()
      );
    }

    // Rules for the users collection (student profiles, plans, progress)
    match /users/{userId} {
      // Students can read/write their own profiles; Admins can view/inspect all student profiles
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Rules for the system collection (default roadmaps)
    match /system/{document=**} {
      // Authenticated users can read the default roadmap templates; Admins can update them
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
